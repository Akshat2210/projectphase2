<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="loginsignup.login.loggedin.processingmanagement.diary.recievediary.RecieveDiary">
  <grid id="27dc6" binding="panel" row-count="2" column-count="6" layout-manager="GridLayoutManager">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="back" class="javax.swing.JButton" binding="backButton">
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Back"/></properties>
      </component>
      <component id="godown" class="javax.swing.JComboBox" binding="godownComboBox">
        <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><toolTipText value="Filter by receiving godown"/></properties>
      </component>
      <component id="entry" class="javax.swing.JComboBox" binding="lotComboBox">
        <constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><toolTipText value="Receive entry / original send lot"/></properties>
      </component>
      <component id="previous" class="javax.swing.JButton" binding="previousButton">
        <constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="&lt;"/><toolTipText value="Previous (older) receive entry"/></properties>
      </component>
      <component id="next" class="javax.swing.JButton" binding="nextButton">
        <constraints><grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="&gt;"/><toolTipText value="Next (newer) receive entry"/></properties>
      </component>
      <component id="customer" class="javax.swing.JComboBox" binding="customerFilter">
        <constraints><grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><toolTipText value="Show all received packets for a customer"/></properties>
      </component>
      <scrollpane id="packets" binding="packetScrollPane">
        <constraints><grid row="1" column="0" row-span="1" col-span="6" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="none"/><children/>
      </scrollpane>
    </children>
  </grid>
</form>
